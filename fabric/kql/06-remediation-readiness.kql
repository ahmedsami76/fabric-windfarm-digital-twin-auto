// Phase 5b: what the operations agent needs to propose a curtailment and to say what it costs.
// Generated by tools/build-phase5.py from tools/remediation_spec.py and data/reference. Change it there.
//
// Run the blocks one at a time in a query window on the KQL database WindFarmEH.
//
// The operations agent reads tables, not functions, and a rule speaks of the columns of the table it
// watches. So the figures a decision needs are written next to the gearbox readings as the telemetry
// arrives: one row per running turbine for each batch, about every 20 seconds.
//
//   The action limits a turbine to 30 percent of its rated 4200 kW, which is 1260 kW.
//   The power above that limit is lost, at the contract price of 38.5 USD/MWh (contracts.csv, CT-PPA-001).
//   A gearbox exchange unit costs 385000 USD and arrives after 140 days (spare_parts.csv, SP-GBX-UNIT).
//   The drivetrain warranty ends on 2026-12-31 (components.csv, all twelve gearboxes).
//
// Readings are averaged over the batch, as in GearboxVsFleetLive, so that one noisy reading is no crossing.
// Only running and derated turbines get a row: a curtailed or stopped turbine is not watched while it is so.

// Block 1. The table, its descriptions for the agent, and the update policy that fills it.
.execute database script <|
.create-merge table GearboxDecisionLive (Timestamp: datetime, TurbineId: string, GearboxVibration: real, GearboxOilTemp: real, GearboxBearingTemp: real, ActivePower: real, WindSpeed: real, CurtailToPercent: int, PowerAfterCurtailKw: real, CurtailCostPerHourUsd: real, CurtailCostPerDayUsd: real, GearboxExchangeUsd: long, GearboxLeadTimeDays: int, WarrantyDaysLeft: int)
//
.alter table GearboxDecisionLive docstring 'One row per running turbine for each batch of telemetry: its gearbox readings, and the cost of limiting it to 30 percent of rated power against what a gearbox failure would cost. Made for the operations agent of Phase 5b.'
//
.alter-merge table GearboxDecisionLive column-docstrings (
    Timestamp: "Time of the newest measurement in the batch, UTC",
    TurbineId: "Turbine, WT-01 to WT-12. Identifies the monitored object",
    GearboxVibration: "Gearbox vibration, mm/s, average of the batch. Early warning at 4, controller alarm at 5.5",
    GearboxOilTemp: "Gearbox oil temperature, degrees Celsius, average of the batch. Early warning at 72, controller alarm at 78",
    GearboxBearingTemp: "Gearbox bearing temperature, degrees Celsius, average of the batch",
    ActivePower: "Power the turbine delivers now, kW, average of the batch",
    WindSpeed: "Wind speed at the nacelle, m/s, average of the batch",
    CurtailToPercent: "The power limit the action 'Curtail turbine' should set, percent of rated power",
    PowerAfterCurtailKw: "Power the turbine would deliver under that limit at the current wind, kW",
    CurtailCostPerHourUsd: "Revenue lost per hour by curtailing now, USD: the power above the limit at the contract price. 0 when the turbine already runs below the limit",
    CurtailCostPerDayUsd: "The same per day if the wind stayed as it is, USD",
    GearboxExchangeUsd: "Price of a gearbox exchange unit, USD: what is at stake if the gearbox fails",
    GearboxLeadTimeDays: "Days until a gearbox exchange unit arrives",
    WarrantyDaysLeft: "Days until the drivetrain warranty ends. 0 or less: it has ended, and the owner pays for a failure"
)
//
.alter table GearboxDecisionLive policy ingestiontime true
//
.alter-merge table GearboxDecisionLive policy retention softdelete = 30d
//
.create-or-alter function with (folder = 'Ingestion', docstring = 'Update policy: gearbox readings of each running turbine with the cost of curtailing it') Expand_GearboxDecisionLive() {
    let RatedPowerKw = 4200.0;
    let CurtailPercent = 30;
    let PriceUsdPerMwh = 38.5;
    let ExchangeUsd = long(385000);
    let LeadTimeDays = 140;
    let WarrantyEnd = datetime(2026-12-31);
    TurbineTelemetry
    | where State in ('RUNNING', 'DERATED')
    | summarize Timestamp = max(Timestamp),
                GearboxVibration = round(avg(GearboxVibration), 2), GearboxOilTemp = round(avg(GearboxOilTemp), 1),
                GearboxBearingTemp = round(avg(GearboxBearingTemp), 1), ActivePower = round(avg(ActivePower), 0),
                WindSpeed = round(avg(WindSpeed), 1) by TurbineId
    | extend CurtailToPercent = toint(CurtailPercent),
             PowerAfterCurtailKw = round(min_of(ActivePower, RatedPowerKw * CurtailPercent / 100.0), 0)
    | extend CurtailCostPerHourUsd = round((ActivePower - PowerAfterCurtailKw) / 1000.0 * PriceUsdPerMwh, 0)
    | extend CurtailCostPerDayUsd = CurtailCostPerHourUsd * 24,
             GearboxExchangeUsd = ExchangeUsd, GearboxLeadTimeDays = toint(LeadTimeDays),
             WarrantyDaysLeft = toint(datetime_diff('day', WarrantyEnd, Timestamp))
    | project Timestamp, TurbineId, GearboxVibration, GearboxOilTemp, GearboxBearingTemp, ActivePower, WindSpeed, CurtailToPercent, PowerAfterCurtailKw, CurtailCostPerHourUsd, CurtailCostPerDayUsd, GearboxExchangeUsd, GearboxLeadTimeDays, WarrantyDaysLeft
}
//
.alter table GearboxDecisionLive policy update @'[{"IsEnabled": true, "Source": "TurbineTelemetry", "Query": "Expand_GearboxDecisionLive()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

// Block 2. Check, a minute later: the newest row of each running turbine. At a wind that gives more
// than 1260 kW, CurtailCostPerHourUsd is above 0; below that it is 0, and curtailing would change nothing.
GearboxDecisionLive
| where Timestamp > ago(5m)
| summarize arg_max(Timestamp, GearboxVibration, GearboxOilTemp, ActivePower, PowerAfterCurtailKw, CurtailCostPerHourUsd, CurtailCostPerDayUsd, WarrantyDaysLeft) by TurbineId
| order by TurbineId asc

// Block 3. What the agent's rule 1 looks at, for one turbine: the batches of the last 15 minutes.
// A crossing is a row above 4 mm/s after a row at or below it.
GearboxDecisionLive
| where Timestamp > ago(15m) and TurbineId == 'WT-03'
| project Timestamp, GearboxVibration, GearboxOilTemp, ActivePower, CurtailCostPerHourUsd
| order by Timestamp desc

// To remove Phase 5b from the database:
// .drop table GearboxDecisionLive ifexists
// .drop function Expand_GearboxDecisionLive ifexists
