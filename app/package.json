{
  "name": "windfarm-twin-workbench",
  "private": true,
  "version": "1.0.0",
  "description": "Builds the standalone preview of the wind farm twin and runs the tests of its code. The app itself is created by create-app.sh from the Rayfin template plus the files in overlay/.",
