{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "css.d.ts",
    "preview-main.tsx",
    "overlay/packages/frontend/src/twin/**/*",
    "overlay/packages/functions/src/**/*",
    "test/**/*"
  ],
  "exclude": [
    "overlay/packages/frontend/src/twin/data/fabricProvider.ts",
    "overlay/packages/functions/src/function_app.ts"
  ]
}
