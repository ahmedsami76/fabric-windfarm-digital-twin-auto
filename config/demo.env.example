# The template of the settings. For a deployment by hand, from the guides, copy it and fill in the blanks:
#   cp config/demo.env.example config/demo.env
# The deployment runner (tools/deploy.py) needs no copy made by you: every deployment it starts gets its
# own, .deploy/<suffix>/demo.env, with generated names. See docs/15-deployment-runner.md, Deployments.
# The scripts read the file ENV_FILE names, else config/demo.env, else the settings of the runner's current
# deployment. Keep the same file on your workstation and on the edge VM. Both places are ignored by git.

# ---- Azure -----------------------------------------------------------------
SUBSCRIPTION_ID=""
# Region for the Arc-enabled cluster. Must be a region supported by Azure IoT
# Operations: eastus, eastus2, westus, westus2, westus3, southcentralus,
# westeurope, northeurope, germanywestcentral.
LOCATION="southcentralus"
RESOURCE_GROUP="rg-windfarm-edge"

# ---- Edge VM ---------------------------------------------------------------
# Also the host name of the VM; the scripts use it to tell the VM from your workstation.
VM_NAME="vm-windfarm-edge"
# Sizes to try, in order of preference; step 1 uses the first one that your
# subscription is offered in the region. All have 8 vCPU and 32 GB, the recommended
# size (4 vCPU and 16 GB is the minimum that Azure IoT Operations supports).
# Subscriptions differ: many are offered only the newer generations (v6, v7).
VM_SIZE="Standard_D8s_v5 Standard_D8s_v6 Standard_D8s_v7 Standard_D8as_v5 Standard_D8as_v6 Standard_D8as_v7"
# User name of the administrator account on the VM. You sign in to the VM as this
# user (ssh azureuser@...), not under your own name.
VM_ADMIN="azureuser"
# Public IP range allowed to reach SSH on the VM, for example 203.0.113.10/32.
# Leave blank to use the public IP of the machine that runs the script.
SSH_SOURCE_CIDR=""
# Daily auto-shutdown of the VM, to limit cost. The time is in UTC (HHMM), not in
# your local time: choose an hour when you are asleep. 0800 UTC is 02:00 in Houston
# and Chicago, 03:00 in New York, 00:00 in Seattle, but 09:00 in Berlin and 13:30 in
# India. Blank disables the shutdown. A stopped VM does not answer SSH and the
# cluster shows as Offline; start it again with: bash infra/vm.sh start
# Change it later with: bash infra/vm.sh shutdown HHMM   (or: bash infra/vm.sh shutdown off)
VM_AUTO_SHUTDOWN_UTC="0800"

# ---- Azure Arc and Azure IoT Operations --------------------------------------
CLUSTER_NAME="arc-windfarm-edge"
AIO_INSTANCE_NAME="aio-windfarm"
CUSTOM_LOCATION_NAME="cl-windfarm-edge"
# Globally unique, 3 to 24 lowercase letters and digits.
STORAGE_ACCOUNT_NAME=""
SCHEMA_REGISTRY_NAME="sr-windfarm"
# Unique within your tenant; lowercase letters, digits and hyphens.
SCHEMA_REGISTRY_NAMESPACE="sr-windfarm-ns"
DEVICE_REGISTRY_NAMESPACE_NAME="adr-windfarm"
# Pricing tier of the Azure IoT Operations instance: Standard or Essentials (both
# are on the Azure IoT Operations pricing page, billed per cluster node). Leave it
# blank: step 4 then lets the CLI use its default, which is what this demo was
# built and run with. Set it only when you want a particular tier.
AIO_SKU=""
# Object ID of the Custom Locations service principal in your tenant.
# infra/01-create-edge-vm.sh prints it; paste it here before step 3. If the script
# cannot read it (Azure Cloud Shell often cannot), docs/troubleshooting.md gives
# three other ways to get it.
# This is an object ID (36 characters, like 01234567-89ab-cdef-0123-456789abcdef), not a
# name. Do not confuse it with CUSTOM_LOCATION_NAME above. The scripts refuse other values.
CUSTOM_LOCATIONS_OID=""
# How the edge VM signs in to Azure for the Arc onboarding (step 3 of the guide):
#   identity = the VM's managed identity. No interactive sign-in on the VM.
#              Step 1 grants it the Arc onboarding role on the resource group
#              and Reader on the subscription.
#   device   = your own account through the device-code flow (az login
#              --use-device-code). Use this if your tenant allows that flow and
#              you prefer not to grant the VM identity any role.
AZ_LOGIN_MODE="identity"

# ---- Microsoft Fabric --------------------------------------------------------
# Names without spaces keep OneLake paths simple.
FABRIC_WORKSPACE_NAME="WindFarmDigitalTwin"
FABRIC_LAKEHOUSE_NAME="WindFarmLH"
# From the eventstream's custom endpoint: Details > Kafka > Entra ID Authentication.
EVENTSTREAM_BOOTSTRAP_SERVER=""     # for example esehxxxxxxxx.servicebus.windows.net:9093
EVENTSTREAM_TOPIC=""                # for example esehxxxxxxxx_eh, or es_aaaaaaaa-0000-1111-2222-bbbbbbbbbbbb
# Phase 5a, the command path from Fabric to the edge (infra/08-create-command-path.sh). Nothing to
# fill in: the script reads the connection from the Fabric API. Remove the "#" only to change a name.
# COMMAND_EVENTSTREAM_NAME="WindFarmCommands"
# COMMAND_ENDPOINT_NAME="fabric-commands"
# COMMAND_DATAFLOW_NAME="fabric-to-windfarm-control"
# Phase 5b, the operations agent that proposes a curtailment (infra/09-remediation-agent.sh). Remove the
# "#" only if your agent or your Eventhouse has another name.
# OPERATIONS_AGENT_NAME="WindFarmGearboxWatch"
# EVENTHOUSE_NAME="WindFarmEH"

# ---- Simulator ---------------------------------------------------------------
SIM_IMAGE="windfarm-simulator:1.2.0"
SIM_NAMESPACE="windfarm"

# ---- Only for tools/deploy.py, the deployment runner (docs/15-deployment-runner.md) ----
# The runner fills these in, in the copy it makes for each deployment. Leave them empty when you deploy by hand.
DEPLOYMENT_SUFFIX=""                # three characters; every generated name ends in them
FABRIC_CAPACITY_ID=""               # the capacity the workspace is created on: an F, trial or P SKU. In a terminal, plan lists them and asks
# The next four are answers to the questions of plan. The runner writes them; by hand only if you run it without a terminal.
FABRIC_CAPACITY_CREATE_SKU=""       # "F16" when the deployment is to make a capacity of its own; empty to use the one above
FABRIC_CAPACITY_NAME=""             # its name: fabwindfarm and the suffix
FABRIC_CAPACITY_REGION=""           # its region as Azure writes it, for example centralus
FABRIC_WORKSPACE_ID=""              # the ID of an existing, empty workspace to use; empty for a new one with the generated name
